{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythopraxis.dev/schemas/workflow.schema.json",
  "title": "Mythopraxis Adaptive Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_version", "id", "title", "approach_id", "start_phase", "max_steps", "no_match", "routes"],
  "properties": {
    "workflow_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "approach_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "start_phase": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 100},
    "no_match": {"const": "pause-for-author"},
    "routes": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "from_phase", "to_phase", "when", "human_approval"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "from_phase": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "to_phase": {"type": "string", "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*|complete)$"},
          "when": {"type": "string", "minLength": 10, "maxLength": 1000},
          "human_approval": {"type": "boolean"}
        }
      }
    }
  }
}
