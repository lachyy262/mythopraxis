{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythopraxis.dev/schemas/claim.schema.json",
  "title": "Mythopraxis Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "status", "scope", "sources", "limitations", "falsification_condition"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "statement": {"type": "string", "minLength": 30},
    "status": {"enum": ["established", "inference", "hypothesis", "falsified-or-unsupported"]},
    "scope": {"type": "string", "minLength": 20},
    "sources": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "limitations": {"type": "string", "minLength": 20},
    "falsification_condition": {"type": "string", "minLength": 20}
  }
}
