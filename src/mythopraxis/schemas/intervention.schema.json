{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythopraxis.dev/schemas/intervention.schema.json",
  "title": "Mythopraxis Intervention",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "version", "purpose", "assistant_anchor", "scene",
    "tension", "choice", "postures", "covenant", "pressure_triggers",
    "recovery_cue", "exit_cue", "sources", "claims"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "purpose": {"type": "string", "minLength": 20},
    "assistant_anchor": {"type": "string", "minLength": 30},
    "scene": {"type": "string", "minLength": 40},
    "tension": {"type": "string", "minLength": 40},
    "choice": {"type": "string", "minLength": 30},
    "postures": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "covenant": {"type": "string", "minLength": 30},
    "pressure_triggers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "recovery_cue": {"type": "string", "minLength": 30},
    "exit_cue": {"type": "string", "pattern": "return fully as the Assistant"},
    "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
